# COPY THIS FILE TO .env AND FILL IN YOUR VALUES

# Telnyx webhook signing key (base64 encoded from Telnyx portal)
# Get this from: Telnyx Portal → Messaging → Messaging Profiles → Webhook Signing Key
TELNYX_PUBLIC_KEY=your_base64_encoded_public_key_here

# Resend API key (get from https://resend.com/api-keys)
RESEND_API_KEY=re_your_resend_api_key_here

# Email configuration
# EMAIL_FROM must be a verified sender in your Resend account
EMAIL_FROM=onboarding@resend.dev

# EMAIL_TO is where you want to receive SMS notifications
EMAIL_TO=your-email@example.com

# Port for local development (optional, defaults to 3000)
PORT=3000

# Slack webhook URL for error notifications (optional)
# Get this from: Slack → Apps → Incoming Webhooks
# If not set, error notifications will only be logged to console
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# Message storage directory (optional, defaults to ./messages)
# Messages are stored as JSONL files with automatic rotation at 5MB
MESSAGES_DIR=./messages

# Web UI password protection (optional but recommended)
# Set a strong password to protect the web dashboard
# If not set, the dashboard will be accessible without authentication
UI_PASSWORD=your_secure_password_here
